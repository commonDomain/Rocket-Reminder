{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rocket Reminder",
  "version": "0.1.0",
  "identifier": "com.local.rocket-reminder",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "reminders",
        "title": "提醒事项",
        "url": "index.html",
        "width": 760,
        "height": 520,
        "visible": false,
        "center": true,
        "skipTaskbar": true
      },
      {
        "label": "add-reminder",
        "title": "新增提醒事项",
        "url": "add.html",
        "width": 380,
        "height": 620,
        "visible": false,
        "center": true,
        "skipTaskbar": true,
        "resizable": false
      },
      {
        "label": "rocket-banner",
        "url": "animation.html",
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
